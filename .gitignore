.gemini/
.aider/
.secrets

# Claude Code local state. The repo's own skill/agent catalog is tracked
# (see .claude/skills/README.md); everything else (settings, sessions,
# worktree state) stays local. Two kinds of skill dirs are regenerated by
# .devcontainer/post-create.sh and re-ignored below: the speckit-* skills
# (written natively by `specify integration upgrade claude`) and the
# externally-sourced ones pulled from their own upstream releases.
/.claude/*
!/.claude/skills/
!/.claude/agents/
/.claude/skills/speckit-*
/.claude/skills/caveman
/.claude/skills/session-handoff

# Spec Kit generated scaffolding — regenerated by .devcontainer/post-create.sh
# to match the installed CLI. The pinned version lives in .specify/speckit.lock
# (tracked); extensions.yml/extensions/workflows are hand-authored (not
# managed by `specify integration upgrade` — neither manifest lists them)
# and have no regeneration path, so they and .specify/memory/ stay tracked.
/.specify/*
!/.specify/memory/
!/.specify/speckit.lock
!/.specify/extensions.yml
!/.specify/extensions/
!/.specify/workflows/

# Editor backup files
*.bak
