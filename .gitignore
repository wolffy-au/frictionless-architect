## Ignore files

# General Python ignore patterns
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environment
.venv
.venv/
venv/
env/
ENV/
virtualenv/
*.egg-info/
dist/
build/
*.log

# FastAPI/SQLAlchemy specific
*.sqlite3

# wiki-librarian semantic index (semsearch.py)
index.sqlite

# Testing ignore patterns
.pytest_cache/
.mypy_cache/

# IDE/Editor specific
.vscode/
.idea/
*.swp
*.swo

# Docker specific
docker-compose.yml
Dockerfile*

# Logging
*.log

# Environment variables
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore files generated by specific tools
# Testing
.pytest_cache/
.coverage
htmlcov/
*.cover

# OS specific
.DS_Store
Thumbs.db

.aider.tags.*
.aider.chat.*
.aider.conf.yml
.aider.input.history
.aider.model.settings.yml

# MyPy cache

# Frontend artifacts
frontend/node_modules/
frontend/dist/
frontend/.cache
frontend/test-results/
.mypy_cache/

# Local cache
.cache/

# Ruff cache
.ruff_cache/
.sonar/
.sonarlint/
.codex/
.gemini/
.aider/
.secrets

# Claude Code local skills
.claude/

# Spec Kit generated scaffolding — regenerated by .devcontainer/post-create.sh
# to match the installed CLI. The pinned version lives in .specify/speckit.lock
# (tracked); hand-owned governance under .specify/memory/ stays tracked too.
/.specify/*
!/.specify/memory/
!/.specify/speckit.lock

# Editor backup files
*.bak
