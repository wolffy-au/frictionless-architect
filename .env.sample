# Environment configuration for frictionless-architect
# Copy this file to `.env` and adjust values before running the visualiser or schema scripts.

# Neo4j schema visualiser (src/frictionless_architect/visualizer)
# Leave the connection blank to run against the bundled sample data.
FRICTIONLESS_ARCHITECT_NEO4J_URI=
FRICTIONLESS_ARCHITECT_NEO4J_USER=
FRICTIONLESS_ARCHITECT_NEO4J_PASSWORD=
FRICTIONLESS_ARCHITECT_SAMPLE_DATA_DIR=sample-data
FRICTIONLESS_ARCHITECT_CACHE_DIR=.cache/visualiser
FRICTIONLESS_ARCHITECT_WARNING_TEXT=Sample data unavailable

# Neo4j schema bootstrap (used by `scripts/neo4j_schema.py`)
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j
